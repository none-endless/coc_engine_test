      "extensions": {}
    },
    "map-west_room-0004": {
      "id": "map-west_room-0004",
      "name": "碧纱橱外间",
      "description": {
        "public": [
          "碧纱橱外间陈设清雅，暖香浮动，一位面目清俊的少年正匆匆赶来。",
          "他胸前所佩通灵玉最先映入眼帘，而这场相见也注定不会只是寻常寒暄。"
        ],
        "hint": "若在此与宝玉会面，便会触发更具小说意味的初会结局。",
        "add": []
      },
